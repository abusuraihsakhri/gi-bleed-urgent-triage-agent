{
  "openapi": "3.1.0",
  "info": {
    "title": "Upper GI bleeding clinical score API",
    "version": "2.1.0",
    "description": "Educational score calculation; the generated /openapi.json endpoint is the canonical full schema."
  },
  "paths": {
    "/api/gbs": {
      "post": {
        "summary": "Calculate GBS",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bun_mmol_l",
                  "hemoglobin_g_dl",
                  "sex",
                  "sbp_mmhg",
                  "heart_rate",
                  "melena",
                  "syncope",
                  "hepatic_disease",
                  "cardiac_failure"
                ],
                "properties": {
                  "bun_mmol_l": {
                    "type": "number"
                  },
                  "hemoglobin_g_dl": {
                    "type": "number"
                  },
                  "sex": {
                    "type": "string"
                  },
                  "sbp_mmhg": {
                    "type": "number"
                  },
                  "heart_rate": {
                    "type": "number"
                  },
                  "melena": {
                    "type": "boolean"
                  },
                  "syncope": {
                    "type": "boolean"
                  },
                  "hepatic_disease": {
                    "type": "boolean"
                  },
                  "cardiac_failure": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoring result with clinical caveat"
          },
          "422": {
            "description": "Invalid or missing clinical inputs"
          }
        }
      }
    },
    "/api/aims65": {
      "post": {
        "summary": "Calculate AIMS65",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "albumin_g_dl",
                  "inr",
                  "mental_status_altered",
                  "sbp_mmhg",
                  "age"
                ],
                "properties": {
                  "albumin_g_dl": {
                    "type": "number"
                  },
                  "inr": {
                    "type": "number"
                  },
                  "mental_status_altered": {
                    "type": "boolean"
                  },
                  "sbp_mmhg": {
                    "type": "number"
                  },
                  "age": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoring result with clinical caveat"
          },
          "422": {
            "description": "Invalid or missing clinical inputs"
          }
        }
      }
    },
    "/api/rockall": {
      "post": {
        "summary": "Calculate ROCKALL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "age",
                  "shock_hr",
                  "shock_sbp",
                  "comorbidity",
                  "endoscopic_diagnosis",
                  "major_stigmata"
                ],
                "properties": {
                  "age": {
                    "type": "integer"
                  },
                  "shock_hr": {
                    "type": "number"
                  },
                  "shock_sbp": {
                    "type": "number"
                  },
                  "comorbidity": {
                    "type": "string"
                  },
                  "endoscopic_diagnosis": {
                    "type": "string"
                  },
                  "major_stigmata": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoring result with clinical caveat"
          },
          "422": {
            "description": "Invalid or missing clinical inputs"
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    }
  }
}
